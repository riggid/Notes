# Ignore Obsidian's local cache
/.obsidian/cache/

# Ignore old/deprecated workspace file (conflicts with workspace.json)
/.obsidian/workspace

# Ignore mobile-specific workspace layout
/.obsidian/workspace-mobile.json

# Ignore local app settings (like window size)
/.obsidian/config

# Ignore the 'smart-env' plugin data (from your previous file)
/.obsidian/plugins/copilot/data.json
/copilot

# Ignore '.ajson' files (from your previous file)
*.ajson

/.obsidian/workspace.json

